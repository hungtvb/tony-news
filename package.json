{
  "name": "tony-news",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test packages/**/*.test.ts",
    "test:integration": "node --experimental-strip-types --test packages/**/*.integration.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "benchmark:validate": "node --experimental-strip-types apps/worker/src/benchmark-validate.ts",
    "cluster:evaluate": "node --experimental-strip-types apps/worker/src/event-relation-evaluate.ts",
    "rss:smoke": "node --experimental-strip-types apps/worker/src/rss-smoke.ts",
    "article:smoke": "node --experimental-strip-types apps/worker/src/article-smoke.ts",
    "article:structure": "node --experimental-strip-types apps/worker/src/article-structure-smoke.ts",
    "browser-run:smoke": "node --experimental-strip-types apps/worker/src/browser-run-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
